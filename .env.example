# Copy this file to .env and fill in values. Never commit your real .env.

# --- Gemma / Google Gen AI ------------------------------------------------
# Used for three things only: (1) interpreting the patient's spoken
# check-in transcript into one of a small set of allowed intents, (2)
# proposing one of six constrained application tools, and (3) generating a
# grounded caregiver handoff from verified facts. Never used for medical
# decisions or glucose thresholds - see README "Safety architecture".
GEMINI_API_KEY=
GEMMA_MODEL=

# Master switches. When false, GlucoRelay uses the deterministic
# keyword-based fallback parser / fallback handoff builder instead - the
# app keeps working, just without natural-language or multilingual
# understanding. See README "Which defining features are lost without Gemma".
ENABLE_GEMMA=true
ENABLE_GEMMA_HANDOFF=true

# Generic caregiver display name used whenever the patient did not
# explicitly name a contact during a voice check-in (e.g. in the caregiver
# handoff and alert text). Never overrides a contact name the patient
# actually stated.
DEFAULT_CAREGIVER_NAME=Helper

# --- Caregiver SMS notifications -----------------------------------------
# When ENABLE_SMS is false (default), alerts are printed to the server
# console instead of sent via Twilio - safe for demos without credentials.
ENABLE_SMS=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
EMERGENCY_CONTACT_NUMBER=

# Base URL used to build the caregiver acknowledgement link included in
# alerts, e.g. http://127.0.0.1:8000/caregiver/{public_token}
PUBLIC_BASE_URL=http://127.0.0.1:8000

# --- Check-in timing -------------------------------------------------------
# Seconds to wait for a patient response before auto-escalating to
# "contacting". In-memory timer: fine for this hackathon prototype, but a
# production system would need a durable job queue.
CHECK_IN_TIMEOUT_SECONDS=30

# --- Deterministic glucose thresholds (mg/dL) -----------------------------
# These decisions are always made by Python, never by Gemma.
DEMO_LOW_THRESHOLD=70
DEMO_URGENT_LOW_THRESHOLD=55
DEMO_HIGH_THRESHOLD=250
